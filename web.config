<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
          <rules>
            <!-- Rule to redirect index.html to the root -->
            <rule name="Redirect index.html to root" stopProcessing="true">
              <match url="^index\.html$" />
              <action type="Redirect" url="/" redirectType="Permanent" />
            </rule>
            <!-- Rule to redirect lizberries/index.html to lizberries/ -->
            <rule name="Redirect lizberries/index.html to lizberries/" stopProcessing="true">
              <match url="^lizberries/index\.html$" />
              <action type="Redirect" url="/lizberries/" redirectType="Permanent" />
            </rule>
			<!-- Rule to redirect 5cerealiz/index.html to 5cerealiz/ -->
            <rule name="Redirect 5cereali/index.html to 5cerealiz/" stopProcessing="true">
              <match url="^5cerealiz/index\.html$" />
              <action type="Redirect" url="/5cerealiz/" redirectType="Permanent" />
            </rule>
          </rules>
        </rewrite>
        <staticContent>
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <!-- Cache per risorse statiche: max 30 giorni (limite IIS) -->
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
        </staticContent>
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <!-- Security headers -->
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <!--
                    Content-Security-Policy
                    ========================
                    Dominio per dominio:
                    · cdn.jsdelivr.net        → Bootstrap CSS, Bootstrap Icons CSS+font
                    · cdnjs.cloudflare.com    → normalize.min.css, magnific-popup.js
                    · gigstarter.s3.amazonaws → Gigstarter booking SDK
                    · connect.facebook.net    → Facebook JS SDK (lizberries & 5cerealiz)
                    · *.fbcdn.net             → CDN immagini Facebook (Page Plugin)
                    · open.spotify.com        → Spotify embed
                    · www.facebook.com        → Facebook iframe plugin + API
                    · graph.facebook.com      → Facebook SDK API calls
                    · www.youtube.com         → YouTube embed (lizberries & 5cerealiz)
                    · www.gigstarter.it       → Gigstarter widget/iframe
                    · contact-verify.liz...   → Cloudflare Worker form di contatto
                    'unsafe-inline' script    → necessario per <link onload> (async CSS)
                    'unsafe-inline' style     → necessario per <style> critico inline
                                                e attributi style= usati da Bootstrap JS
                -->
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://gigstarter.s3.amazonaws.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' https://s3-eu-west-1.amazonaws.com https://*.fbcdn.net data:; frame-src https://open.spotify.com https://www.facebook.com https://www.youtube.com https://www.gigstarter.it; connect-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://contact-verify.lizberries.workers.dev https://www.facebook.com https://graph.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self';" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>